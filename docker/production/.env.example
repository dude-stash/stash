# Set this to an absolute path outside the repo to keep Docker runtime data
# out of your working tree. Defaults to ./stash-data next to docker-compose.yml.
#STASH_DATA_DIR=/home/user/stash-data

# Optional: override just the media/collection mount (/data in the container).
# Useful when your media lives on an external drive separate from other stash data.
#STASH_MEDIA_DIR=/Volumes/MyDrive/Media
